<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.AlunosController">
   <children>
      <Label layoutX="491.0" layoutY="14.0" text="Alunos" />
      <TableView fx:id="tableAlunos" layoutX="151.0" layoutY="53.0" prefHeight="286.0" prefWidth="804.0">
        <columns>
          <TableColumn fx:id="columnIdAluno" prefWidth="37.0" text="id" />
          <TableColumn fx:id="columnNameAluno" prefWidth="342.0" text="Nome" />
            <TableColumn fx:id="columnCpfAluno" prefWidth="171.0" text="CPF" />
            <TableColumn fx:id="columnDateBirthAluno" prefWidth="122.0" text="Data Nasc" />
            <TableColumn fx:id="columnPlainAluno" prefWidth="131.0" text="Plano" />
        </columns>
      </TableView>
      <Button fx:id="insertAlunoBtn" layoutX="7.0" layoutY="75.0" mnemonicParsing="false" onAction="#onInsertAlunoBtnAction" text="Inserir novo Aluno" />
      <Button fx:id="alterAlunoBtn" layoutX="23.0" layoutY="138.0" mnemonicParsing="false" onAction="#onAlterAlunoBtnAction" text="Alterar Aluno" />
      <Button fx:id="deleteAlunoBtn" layoutX="17.0" layoutY="206.0" mnemonicParsing="false" text="Remover Aluno" />
      <BarChart layoutX="23.0" layoutY="425.0" prefHeight="278.0" prefWidth="425.0">
        <xAxis>
          <CategoryAxis side="BOTTOM" />
        </xAxis>
        <yAxis>
          <NumberAxis side="LEFT" />
        </yAxis>
      </BarChart>
   </children>
</AnchorPane>
