<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.intefaceacademia.PrincipalController">
   <children>
      <Label layoutX="339.0" layoutY="30.0" text="Gerenciador De Academia Qualquer">
         <font>
            <Font name="JetBrains Mono Bold" size="18.0" />
         </font>
      </Label>
      <Button fx:id="btnAlunos" layoutX="79.0" layoutY="168.0" mnemonicParsing="false" onAction="#onBtnAlunosClick" text="Alunos">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button fx:id="planos" layoutX="79.0" layoutY="536.0" mnemonicParsing="false" onAction="#onBtnPlanosClick" text="Planos">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button fx:id="pagamentos" layoutX="79.0" layoutY="329.0" mnemonicParsing="false" onAction="#onBtnPagamentosClick" text="Pagamentos">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <TableView layoutX="260.0" layoutY="159.0" prefHeight="529.0" prefWidth="671.0">
        <columns>
          <TableColumn prefWidth="302.0" text="Aluno" />
          <TableColumn prefWidth="129.0" text="Plano" />
            <TableColumn minWidth="0.0" prefWidth="239.0" text="Data do Último Pagamento" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
